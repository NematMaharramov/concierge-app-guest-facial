generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CONCIERGE
}

enum ReservationStatus {
  PENDING
  ARRANGED
  NOT_ARRANGED
  CANCELLED
  COMPLETED
}

// ─── Business Vertical Templates (Part 2) ──────────────────────
// A vertical is a "starter kit" of categories (+ later, filter groups —
// see Part 3) for a type of hospitality business. When a new Tenant is
// created for a given vertical, CategoryTemplate rows for that vertical
// are copied into real, tenant-owned Category rows.
enum BusinessVertical {
  RESORT_LEISURE
  BUSINESS_CITY_HOTEL
  BOUTIQUE_HOTEL
  CUSTOM
}

model CategoryTemplate {
  id          String   @id @default(uuid())
  vertical    BusinessVertical
  name        String
  slug        String
  icon        String?
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  filterGroups FilterGroupTemplate[]

  @@unique([vertical, slug])
}

// Lightweight template for a category's sub-filters (e.g. "Cuisine Type").
// `options` is a plain JSON string array at the template stage — it only
// becomes real, queryable FilterGroup/FilterOption rows once a tenant is
// instantiated (see Part 3, which defines those relational models and the
// copy step that consumes this template).
model FilterGroupTemplate {
  id                 String   @id @default(uuid())
  categoryTemplateId String
  name               String
  options            Json
  isRequired         Boolean  @default(false)
  sortOrder          Int      @default(0)

  categoryTemplate CategoryTemplate @relation(fields: [categoryTemplateId], references: [id], onDelete: Cascade)
}

// ─── Multi-tenancy (Part 1) ─────────────────────────────────────
// tenantId is nullable on purpose: schema changes must stay backward
// compatible with `prisma db push` against a live database that already
// has rows. A separate backfill script (prisma/backfill-tenant.ts) fills
// existing rows with a default "Demo Tenant" before we ever tighten this
// to NOT NULL in a later Part.
model Tenant {
  id               String            @id @default(uuid())
  name             String
  slug             String            @unique
  customDomain     String?           @unique
  businessVertical BusinessVertical?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  branding     TenantBranding?
  featureFlags TenantFeatureFlag[]
  users        User[]
  categories   Category[]
  services     Service[]
  reservations Reservation[]
  auditLogs    AuditLog[]
  events       Event[]
  letterTemplates     LetterTemplate[]
  roomTypes           RoomTypeInfo[]
  guestCommunications GuestCommunication[]
  integrations        TenantIntegration[]
  taxiDrivers         TaxiDriver[]
  phoneDirectory      PhoneDirectoryEntry[]
  priceSheetItems     PriceSheetItem[]
}

model TenantBranding {
  id           String   @id @default(uuid())
  tenantId     String   @unique
  logoUrl      String?
  primaryColor String?
  accentColor  String?
  siteTitle    String?
  siteSubtitle String?
  // Part 5: hotel coordinates, used to fetch the arrival-day weather
  // forecast for a pre-arrival letter's {{weather_forecast}} field.
  latitude     Float?
  longitude    Float?
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// Simple on/off switches per tenant for optional platform modules (e.g.
// "excel_import", "monthly_events", "pre_arrival_letters", "taxi_directory").
// Consumed by later Parts (9, etc.) — Part 7 only needs the Super Admin UI
// to toggle these; nothing reads them yet, so unknown/default keys are
// harmless.
model TenantFeatureFlag {
  id        String   @id @default(uuid())
  tenantId  String
  key       String
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
}

model User {
  id           String   @id @default(uuid())
  tenantId     String?
  email        String   @unique
  password     String
  name         String
  role         Role     @default(CONCIERGE)
  isActive     Boolean  @default(true)
  profilePhoto String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant?       @relation(fields: [tenantId], references: [id])
  reservations Reservation[]
  auditLogs    AuditLog[]
  guestCommunicationsSent GuestCommunication[]

  @@index([tenantId])
}

model Category {
  id          String    @id @default(uuid())
  tenantId    String?
  name        String
  slug        String
  description String?
  icon        String?
  photo       String?
  sortOrder   Int       @default(0)
  isVisible   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
  services    Service[]
  filterGroups FilterGroup[]

  @@unique([tenantId, slug])
  @@unique([tenantId, name])
  @@index([tenantId])
}

// ─── Facet / Filter system (Part 3) ─────────────────────────────
// A Category can optionally have one or more FilterGroups (e.g. "Cuisine
// Type" on Restaurants). If a category has none, the guest site renders a
// plain list — the frontend detects this automatically rather than
// special-casing categories by slug. FilterGroups are either copied in
// from a CategoryTemplate at tenant-creation time (Part 2), or created by
// hand by a tenant ADMIN (not restricted to template-provided groups).
model FilterGroup {
  id         String   @id @default(uuid())
  tenantId   String?
  categoryId String
  name       String
  isRequired Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  options  FilterOption[]

  @@index([tenantId])
  @@index([categoryId])
}

model FilterOption {
  id            String   @id @default(uuid())
  filterGroupId String
  label         String
  sortOrder     Int      @default(0)

  filterGroup FilterGroup          @relation(fields: [filterGroupId], references: [id], onDelete: Cascade)
  services    ServiceFilterValue[]
}

// Many-to-many: a service can match more than one option in the same
// group (e.g. a restaurant that's both "Japanese" and "Fusion").
model ServiceFilterValue {
  serviceId      String
  filterOptionId String

  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  filterOption FilterOption @relation(fields: [filterOptionId], references: [id], onDelete: Cascade)

  @@id([serviceId, filterOptionId])
}

model Service {
  id            String    @id @default(uuid())
  tenantId      String?
  categoryId    String
  name          String
  description   String?
  priceInfo     String?
  priceAmount   Float?
  priceCurrency String?   @default("EUR")
  contactName   String?
  contactPhone  String?
  details       Json?
  sortOrder     Int       @default(0)
  isVisible     Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant        Tenant?   @relation(fields: [tenantId], references: [id])
  category      Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  images        ServiceImage[]
  reservations  Reservation[]
  filterValues  ServiceFilterValue[]

  @@index([tenantId])
}

model ServiceImage {
  id        String   @id @default(uuid())
  serviceId String
  url       String
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model Reservation {
  id          String            @id @default(uuid())
  tenantId    String?
  userId      String
  serviceId   String
  guestName   String
  guestCount  Int               @default(1)
  dateTime    DateTime
  status      ReservationStatus @default(PENDING)
  notes       String?
  totalPrice  Float?
  currency    String?           @default("EUR")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  tenant      Tenant?           @relation(fields: [tenantId], references: [id])
  user        User              @relation(fields: [userId], references: [id])
  service     Service           @relation(fields: [serviceId], references: [id])
  auditLogs   AuditLog[]

  @@index([tenantId])
}

// ─── Monthly Events (Part 4) ─────────────────────────────────────
// A hotel's own calendar of things happening (concerts, festivals, hotel
// functions). Two consumers: an optional guest-site section (gated by the
// 'monthly_events' TenantFeatureFlag from Part 7 — some hotels won't want
// this), and Part 5's Pre-Arrival Letter wizard, which surfaces events
// overlapping a guest's stay dates as suggestions to include in the letter.
model Event {
  id          String    @id @default(uuid())
  tenantId    String
  title       String
  description String?
  imageUrl    String?
  startDate   DateTime
  endDate     DateTime?
  location    String?
  category    String?   // free-text ("Music", "Culinary", "Cultural") — no filter system needed here
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([startDate])
}

model AuditLog {
  id             String      @id @default(uuid())
  tenantId       String?
  userId         String
  reservationId  String?
  action         String
  entityType     String
  entityId       String
  changes        Json?
  ipAddress      String?
  createdAt      DateTime    @default(now())

  tenant         Tenant?     @relation(fields: [tenantId], references: [id])
  user           User        @relation(fields: [userId], references: [id])
  reservation    Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([tenantId])
}

model SiteSettings {
  id              String   @id @default(uuid())
  key             String   @unique
  value           String
  updatedAt       DateTime @updatedAt
}

// ─── Pre-Arrival Letter system (Part 5) ─────────────────────────

model LetterTemplate {
  id        String   @id @default(uuid())
  tenantId  String
  name      String              // "Standard Pre-Arrival"
  subject   String              // merge-field aware: "Welcome to {{hotel_name}}, {{guest_first_name}}!"
  bodyHtml  String              // rich-text HTML with {{merge_field}} placeholders
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant               @relation(fields: [tenantId], references: [id])
  communications GuestCommunication[]

  @@index([tenantId])
}

// Room-type -> inclusions text, maintained by hand. Needed even when a
// tenant has no PMS connection at all (the always-available fallback path
// the spec explicitly requires), and used to resolve the PMS room code to
// readable inclusions text when a PMS *is* connected.
model RoomTypeInfo {
  id             String   @id @default(uuid())
  tenantId       String
  roomTypeName   String
  inclusionsText String?
  pmsRoomCode    String?  // optional: the code Opera sends, if known

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, roomTypeName])
  @@index([tenantId])
}

// One row per sent (or failed) pre-arrival letter. finalHtml is a frozen
// copy — editing the LetterTemplate later must never change what a
// previously-sent letter is shown as having said (spec's audit requirement).
model GuestCommunication {
  id               String   @id @default(uuid())
  tenantId         String
  guestName        String
  guestEmail       String
  pmsReservationId String?
  templateId       String
  finalHtml        String
  eventIds         Json?
  weatherSnapshot  Json?
  sentByUserId     String
  sentAt           DateTime @default(now())
  status           String   @default("SENT") // SENT / FAILED

  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  template LetterTemplate @relation(fields: [templateId], references: [id])
  sentBy   User           @relation(fields: [sentByUserId], references: [id])

  @@index([tenantId])
}

// Generic per-tenant credential storage for external integrations
// (Outlook, and eventually Opera PMS). Secrets are encrypted at rest via
// CryptoService (Part 8) — never stored as plaintext.
model TenantIntegration {
  id                 String   @id @default(uuid())
  tenantId           String
  provider           String   // "outlook" | "opera"
  encryptedCredentials String? // JSON blob, encrypted (client secret, tokens, etc.)
  config             Json?    // non-secret config (e.g. sender mailbox address)
  isActive           Boolean  @default(false)
  updatedAt          DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, provider])
  @@index([tenantId])
}

// ─── Staff Utility Modules (Part 9) ──────────────────────────────
// Visibility of each one is gated by its matching TenantFeatureFlag
// (taxi_directory / phone_directory / price_sheets, from Part 7) — e.g. a
// business hotel tenant can leave the taxi directory off entirely rather
// than showing an empty, irrelevant list to their concierges.

model TaxiDriver {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  phone       String
  vehicleInfo String?
  notes       String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model PhoneDirectoryEntry {
  id         String   @id @default(uuid())
  tenantId   String
  name       String
  phone      String
  department String?
  notes      String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

// Freeform quick-reference pricing not tied to a bookable Service (e.g.
// "Late checkout fee", "Extra towel") — grouped by a free-text category
// label since these don't need the full Category/FilterGroup machinery.
model PriceSheetItem {
  id        String   @id @default(uuid())
  tenantId  String
  category  String
  label     String
  price     Float?
  currency  String?  @default("EUR")
  unit      String?
  notes     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}
