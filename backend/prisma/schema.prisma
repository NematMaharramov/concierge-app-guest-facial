generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CONCIERGE
}

enum ReservationStatus {
  PENDING
  ARRANGED
  NOT_ARRANGED
  CANCELLED
  COMPLETED
}

// ─── Business Vertical Templates (Part 2) ──────────────────────
// A vertical is a "starter kit" of categories (+ later, filter groups —
// see Part 3) for a type of hospitality business. When a new Tenant is
// created for a given vertical, CategoryTemplate rows for that vertical
// are copied into real, tenant-owned Category rows.
enum BusinessVertical {
  RESORT_LEISURE
  BUSINESS_CITY_HOTEL
  BOUTIQUE_HOTEL
  CUSTOM
}

model CategoryTemplate {
  id          String   @id @default(uuid())
  vertical    BusinessVertical
  name        String
  slug        String
  icon        String?
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  filterGroups FilterGroupTemplate[]

  @@unique([vertical, slug])
}

// Lightweight template for a category's sub-filters (e.g. "Cuisine Type").
// `options` is a plain JSON string array at the template stage — it only
// becomes real, queryable FilterGroup/FilterOption rows once a tenant is
// instantiated (see Part 3, which defines those relational models and the
// copy step that consumes this template).
model FilterGroupTemplate {
  id                 String   @id @default(uuid())
  categoryTemplateId String
  name               String
  options            Json
  isRequired         Boolean  @default(false)
  sortOrder          Int      @default(0)

  categoryTemplate CategoryTemplate @relation(fields: [categoryTemplateId], references: [id], onDelete: Cascade)
}

// ─── Multi-tenancy (Part 1) ─────────────────────────────────────
// tenantId is nullable on purpose: schema changes must stay backward
// compatible with `prisma db push` against a live database that already
// has rows. A separate backfill script (prisma/backfill-tenant.ts) fills
// existing rows with a default "Demo Tenant" before we ever tighten this
// to NOT NULL in a later Part.
model Tenant {
  id               String            @id @default(uuid())
  name             String
  slug             String            @unique
  businessVertical BusinessVertical?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  branding     TenantBranding?
  users        User[]
  categories   Category[]
  services     Service[]
  reservations Reservation[]
  auditLogs    AuditLog[]
}

model TenantBranding {
  id           String   @id @default(uuid())
  tenantId     String   @unique
  logoUrl      String?
  primaryColor String?
  accentColor  String?
  siteTitle    String?
  siteSubtitle String?
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model User {
  id           String   @id @default(uuid())
  tenantId     String?
  email        String   @unique
  password     String
  name         String
  role         Role     @default(CONCIERGE)
  isActive     Boolean  @default(true)
  profilePhoto String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant?       @relation(fields: [tenantId], references: [id])
  reservations Reservation[]
  auditLogs    AuditLog[]

  @@index([tenantId])
}

model Category {
  id          String    @id @default(uuid())
  tenantId    String?
  name        String
  slug        String
  description String?
  icon        String?
  photo       String?
  sortOrder   Int       @default(0)
  isVisible   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
  services    Service[]

  @@unique([tenantId, slug])
  @@unique([tenantId, name])
  @@index([tenantId])
}

model Service {
  id            String    @id @default(uuid())
  tenantId      String?
  categoryId    String
  name          String
  description   String?
  priceInfo     String?
  priceAmount   Float?
  priceCurrency String?   @default("EUR")
  contactName   String?
  contactPhone  String?
  details       Json?
  sortOrder     Int       @default(0)
  isVisible     Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant        Tenant?   @relation(fields: [tenantId], references: [id])
  category      Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  images        ServiceImage[]
  reservations  Reservation[]

  @@index([tenantId])
}

model ServiceImage {
  id        String   @id @default(uuid())
  serviceId String
  url       String
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model Reservation {
  id          String            @id @default(uuid())
  tenantId    String?
  userId      String
  serviceId   String
  guestName   String
  guestCount  Int               @default(1)
  dateTime    DateTime
  status      ReservationStatus @default(PENDING)
  notes       String?
  totalPrice  Float?
  currency    String?           @default("EUR")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  tenant      Tenant?           @relation(fields: [tenantId], references: [id])
  user        User              @relation(fields: [userId], references: [id])
  service     Service           @relation(fields: [serviceId], references: [id])
  auditLogs   AuditLog[]

  @@index([tenantId])
}

model AuditLog {
  id             String      @id @default(uuid())
  tenantId       String?
  userId         String
  reservationId  String?
  action         String
  entityType     String
  entityId       String
  changes        Json?
  ipAddress      String?
  createdAt      DateTime    @default(now())

  tenant         Tenant?     @relation(fields: [tenantId], references: [id])
  user           User        @relation(fields: [userId], references: [id])
  reservation    Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([tenantId])
}

model SiteSettings {
  id              String   @id @default(uuid())
  key             String   @unique
  value           String
  updatedAt       DateTime @updatedAt
}
